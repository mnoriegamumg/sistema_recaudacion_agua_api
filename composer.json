{
    "name": "sistema/sistema_recaudacion_agua_api",
    "description": "API para sistema de recaudación de agua potable",
    "type": "project",
    "require": {
        "php": "^8.0",
        "firebase/php-jwt": "6.11.1",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^2.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform-check": false,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public"
    }
}